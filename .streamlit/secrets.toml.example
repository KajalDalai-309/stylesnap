GEMINI_API_KEY = "your-gemini-api-key-here"

# Optional: change the Gemini model if needed
# GEMINI_MODEL = "gemini-3.8-flash"

# Gmail account that SENDS the emails
GMAIL_ADDRESS = "your-gmail-address@gmail.com"
# 16-character App Password from myaccount.google.com/apppasswords
# (never your real Gmail password)
GMAIL_APP_PASSWORD = "your-16-char-app-password"
